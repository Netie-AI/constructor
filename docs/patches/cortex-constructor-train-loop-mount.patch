+@router.post("/cortex/constructor/decision")
+def constructor_decision(
+    body: ConstructorDecisionBody,
+    caller: Caller = Depends(require_constructor_viewer),
+) -> dict[str, Any]:
+    from CortexOS.constructor_graph import (
+        ConstructorGraphError,
+        compile_constructor_graph,
+        dropped_cycle_edges,
+    )
+
+    try:
+        program = compile_constructor_graph({"nodes": body.nodes, "edges": body.edges})
+    except ConstructorGraphError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    nid = body.node_id or program.entry_node_id
+    node = next((n for n in program.nodes if n.id == nid), None)
+    if node is None:
+        raise HTTPException(status_code=404, detail=f"node {nid!r} not in compiled DAG")
+    kind = node.type.value if hasattr(node.type, "value") else str(node.type)
+    ann = node.annotations if isinstance(node.annotations, dict) else {}
+    _ = caller
+    return {
+        "ok": True,
+        "node_id": node.id,
+        "cortex_kind": kind,
+        "constructor_kind": ann.get("constructor_kind"),
+        "tool_name": node.tool_name,
+        "is_emit": program.output_node_id == node.id,
+        "is_entry": program.entry_node_id == node.id,
+        "inputs": node.inputs,
+        "dropped_cycle_edges": dropped_cycle_edges(body.edges, program),
+        "entry_node_id": program.entry_node_id,
+        "output_node_id": program.output_node_id,
+    }
