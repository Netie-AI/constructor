+++ b/tests/dms/test_constructor_graph.py
@@ -337,3 +337,120 @@ def test_ov_token_resolves_via_openvault(monkeypatch):
     assert caller is not None
     assert caller.role == "viewer"
     assert caller.actor == "ov_k1"
+
+
+LOOP = {
+    "nodes": [
+        {"id": "g1", "kind": "ingest", "object_type": "inventory", "fetch_from": "warehouse.inventory"},
+        {"id": "g2", "kind": "train", "action_type": "model.fit", "checkpoint": "weights"},
+        {"id": "g3", "kind": "infer", "action_type": "model.score"},
+        {"id": "g4", "kind": "audit"},
+        {"id": "g5", "kind": "retrain", "action_type": "model.retrain"},
+        {"id": "g6", "kind": "foundry"},
+        {"id": "g7", "kind": "app"},
+    ],
+    "edges": [
+        {"from": "g1", "to": "g2"},
+        {"from": "g2", "to": "g3"},
+        {"from": "g3", "to": "g4"},
+        {"from": "g4", "to": "g5"},
+        {"from": "g5", "to": "g6"},
+        {"from": "g6", "to": "g7"},
+        {"from": "g5", "to": "g2"},
+    ],
+}
+
+
+def test_compile_train_loop_accepts_kinds_and_drops_cycle():
+    program = compile_constructor_graph(LOOP)
+    by_id = {n.id: n for n in program.nodes}
+    assert program.output_node_id == "g7"
+    assert by_id["g2"].annotations["constructor_kind"] == "train"
+    assert by_id["g3"].annotations["constructor_kind"] == "infer"
+    assert by_id["g5"].annotations["constructor_kind"] == "retrain"
+    assert "g5" not in by_id["g2"].inputs
+    from CortexOS.constructor_graph import dropped_cycle_edges
+
+    dropped = dropped_cycle_edges(LOOP["edges"], program)
+    assert dropped == [{"from": "g5", "to": "g2", "reason": "cycle"}]
+
+
+def test_compile_trigger_and_enhance():
+    program = compile_constructor_graph(
+        {
+            "nodes": [
+                {"id": "t", "kind": "trigger"},
+                {"id": "e", "kind": "enhance"},
+                {"id": "a", "kind": "app"},
+            ],
+            "edges": [{"from": "t", "to": "e"}, {"from": "e", "to": "a"}],
+        }
+    )
+    kinds = {(n.annotations or {}).get("constructor_kind") for n in program.nodes}
+    assert {"trigger", "enhance", "app"} <= kinds
+
+
+def test_ghost_train_loop_with_viewer_key(dms_client, api_keys_env):
+    res = dms_client.post(
+        "/cortex/constructor/ghost",
+        json=LOOP,
+        headers={"X-API-Key": api_keys_env["viewer"]},
+    )
+    assert res.status_code == 200, res.text
+    body = res.json()
+    assert body["ok"] is True
+    assert body["output_node_id"] == "g7"
+    assert body["dropped_cycle_edges"][0]["from"] == "g5"
+    kinds = {n["constructor_kind"] for n in body["nodes"]}
+    assert {"train", "infer", "retrain"} <= kinds
+
+
+def test_generate_and_decision_compile_on_cortex(dms_client, api_keys_env):
+    headers = {"X-API-Key": api_keys_env["viewer"]}
+    empty = dms_client.post("/cortex/constructor/generate", json={"prompt": "lab loop"}, headers=headers)
+    assert empty.status_code == 200
+    assert empty.json()["client_compile"] is True
+    gen = dms_client.post(
+        "/cortex/constructor/generate",
+        json={"prompt": "ingest train set then train then infer then retrain", **LOOP},
+        headers=headers,
+    )
+    assert gen.status_code == 200, gen.text
+    assert gen.json()["ok"] is True
+    assert gen.json()["compiled"]
+    dec = dms_client.post(
+        "/cortex/constructor/decision",
+        json={"node_id": "g2", **LOOP},
+        headers=headers,
+    )
+    assert dec.status_code == 200, dec.text
+    body = dec.json()
+    assert body["constructor_kind"] == "train"
+    assert body["cortex_kind"]
+
+
+def test_nested_skin_core_js_is_served(tmp_path, monkeypatch, api_keys_env):
+    reset_limiter(per_minute=120)
+    skin = tmp_path / "skin"
+    (skin / "core").mkdir(parents=True)
+    (skin / "index.html").write_text('<html><body id="stage"></body></html>')
+    (skin / "core" / "constructor.js").write_text("window.NetieConstructorCore=true;")
+    monkeypatch.setenv("CONSTRUCTOR_SKIN_DIR", str(skin))
+    monkeypatch.setenv("DMS_OPS_DB", str(tmp_path / "ops.db"))
+    from CortexOS.api.app import create_app
+
+    client = TestClient(create_app())
+    res = client.get(
+        "/cortex/constructor/core/constructor.js",
+        headers={"X-API-Key": api_keys_env["viewer"]},
+        follow_redirects=False,
+    )
+    assert res.status_code == 200, res.text
+    assert b"NetieConstructorCore" in res.content
+    denied = client.get(
+        "/cortex/constructor/core/../../pyproject.toml",
+        headers={"X-API-Key": api_keys_env["viewer"]},
+        follow_redirects=False,
+    )
+    assert denied.status_code in (404, 400, 303)
+
